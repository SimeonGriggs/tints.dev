{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tints-dev",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
